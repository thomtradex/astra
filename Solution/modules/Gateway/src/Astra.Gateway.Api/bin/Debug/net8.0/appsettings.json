{
  "ReverseProxy": {
    "Routes": {
      "organization": {
        "ClusterId": "organization",
        "Match": {
          "Path": "/organization/{**catch-all}"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "knowledge": {
        "ClusterId": "knowledge",
        "Match": {
          "Path": "/knowledge/{**catch-all}"
        }
      },
      "planning": {
        "ClusterId": "planning",
        "Match": {
          "Path": "/planning/{**catch-all}"
        }
      },
      "ai": {
        "ClusterId": "ai",
        "Match": {
          "Path": "/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "organization": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5000/"
          }
        }
      },
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5275/"
          }
        }
      },
      "knowledge": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5173/"
          }
        }
      },
      "planning": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5095/"
          }
        }
      },
      "ai": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5168/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}