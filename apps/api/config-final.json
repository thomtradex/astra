{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "module": "commonjs",
        "moduleResolution": "node10",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "incremental": true,
        "removeComments": true,
        "baseUrl": "./",
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "preserveConstEnums": true,
        "useDefineForClassFields": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./src/app.module.ts",
        "./src/main.ts",
        "./src/common/decorators/current-user.decorator.ts",
        "./src/common/decorators/metadata.decorators.ts",
        "./src/common/dto/pagination-query.dto.ts",
        "./src/common/filters/http-exception.filter.ts",
        "./src/config/config.module.ts",
        "./src/config/env.validation.ts",
        "./src/modules/audit/audit.controller.ts",
        "./src/modules/audit/audit.module.ts",
        "./src/modules/audit/audit.service.ts",
        "./src/modules/audit/dto/audit-query.dto.ts",
        "./src/modules/audit/interceptors/audit.interceptor.ts",
        "./src/modules/audit/interfaces/audit-log.interface.ts",
        "./src/modules/auth/auth.controller.ts",
        "./src/modules/auth/auth.module.ts",
        "./src/modules/auth/auth.service.ts",
        "./src/modules/auth/dto/auth.dto.ts",
        "./src/modules/auth/guards/jwt-auth.guard.ts",
        "./src/modules/auth/interfaces/authenticated-user.interface.ts",
        "./src/modules/auth/strategies/jwt.strategy.ts",
        "./src/modules/health/health.controller.spec.ts",
        "./src/modules/health/health.controller.ts",
        "./src/modules/health/health.module.ts",
        "./src/modules/health/health.service.ts",
        "./src/modules/rbac/guards/permissions.guard.ts",
        "./src/modules/users/users.controller.ts",
        "./src/modules/users/users.module.ts",
        "./src/modules/users/users.service.ts",
        "./src/prisma/prisma.module.ts",
        "./src/prisma/prisma.service.ts",
        "./test/setup-env.ts",
        "./test/helpers/test-app.ts",
        "./test/helpers/test-data.ts",
        "./test/integration/auth.integration.spec.ts",
        "./test/integration/rbac.integration.spec.ts",
        "./test/integration/tenant-isolation.integration.spec.ts"
    ],
    "include": [
        "src/**/*",
        "test/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
