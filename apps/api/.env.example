# =============================================================================
# Astra API — Environment Variables
# Copy to .env in this directory or use root .env
# =============================================================================

NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

DATABASE_URL="postgresql://astra:astra_dev_password@localhost:5432/astra?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
