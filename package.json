{
  "name": "astra",
  "version": "0.1.0",
  "private": true,
  "description": "Astra — Operational Intelligence Platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "architecture:check": "node scripts/architecture/check-boundaries.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "db:generate": "pnpm --filter @astra/database db:generate",
    "db:migrate": "pnpm --filter @astra/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @astra/database db:migrate:deploy",
    "db:seed": "pnpm --filter @astra/database db:seed",
    "db:studio": "pnpm --filter @astra/database db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@astra/eslint-config": "workspace:*",
    "@astra/typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
